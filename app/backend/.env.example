# ===== Wedding Admin Backend - cấu hình môi trường =====
# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# Cổng chạy API
PORT=4100

# Bí mật ký JWT — đổi thành chuỗi ngẫu nhiên dài trên production
JWT_SECRET=doi-chuoi-nay-thanh-ngau-nhien-dai
JWT_EXPIRES_IN=7d

# Đường dẫn file database SQLite (mặc định: data/wedding-admin.db)
DB_PATH=

# CORS: domain của app frontend, ngăn cách bằng dấu phẩy. Để * cho dev.
CORS_ORIGIN=*

# ===== Kết nối repo website tĩnh (để "Công bố" nội dung) =====
# Khi bấm Công bố, backend ghi data/*.json vào bản sao repo website rồi commit + push.
# 1) URL repo website (dùng HTTPS kèm token để push không cần SSH key trên server)
WEBSITE_REPO_URL=https://github.com/qt16tc32nghoainam-a11y/website-Wedding.git
# 2) Nhánh publish
WEBSITE_REPO_BRANCH=main
# 3) GitHub Personal Access Token (scope: repo). Dùng để push lên repo website.
#    Tạo tại: GitHub > Settings > Developer settings > Personal access tokens.
GITHUB_TOKEN=
# 4) Tên & email hiển thị trên commit
GIT_AUTHOR_NAME=Wedding Admin
GIT_AUTHOR_EMAIL=admin@quocanstudio.vn
# 5) Thư mục chứa bản sao repo website trên server (mặc định: data/website-repo)
WEBSITE_REPO_DIR=

# ===== Email tự động (SMTP) =====
# Cấu hình SMTP nhập trực tiếp trong app (menu Cấu hình email, chỉ Admin). Mật khẩu được
# mã hóa trước khi lưu DB bằng khóa dưới đây. Đặt chuỗi ngẫu nhiên riêng trên production.
APP_ENCRYPTION_KEY=doi-chuoi-ma-hoa-ngau-nhien-rieng
# Tên hiển thị trong email gửi cho nhân viên
APP_NAME=Quốc An Studio
