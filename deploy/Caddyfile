# Caddy reverse proxy + tự cấp HTTPS (Let's Encrypt).
# Đặt tại /etc/caddy/Caddyfile, rồi: systemctl reload caddy
#
# Cách B: VPS host cả 2 site. Trước khi reload, tạo bản ghi A trỏ về IP VPS:
#     studioquocan.vn        -> IP-VPS   (website khách xem)
#     www.studioquocan.vn    -> IP-VPS
#     admin.studioquocan.vn  -> IP-VPS   (app quản trị)

# ---- Website khách xem (build tĩnh, phục vụ ở cổng 8080) ----
studioquocan.vn, www.studioquocan.vn {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8080
}

# ---- App quản trị (Node, cổng 4100) ----
admin.studioquocan.vn {
    encode zstd gzip
    reverse_proxy 127.0.0.1:4100
}

# ------------------------------------------------------------------
# CHƯA có tên miền? Truy cập tạm bằng IP + cổng, KHÔNG cần Caddy:
#   - Website khách xem: http://IP-VPS:8080
#   - App quản trị:      http://IP-VPS:4100
# Khi có tên miền thì trỏ DNS như trên rồi: systemctl reload caddy
