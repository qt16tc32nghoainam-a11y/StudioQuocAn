# Caddy reverse proxy + tự cấp HTTPS (Let's Encrypt).
# Đặt tại /etc/caddy/Caddyfile, rồi: systemctl reload caddy
#
# App quản trị chạy ở subdomain admin.studioquocan.vn (tách khỏi website khách xem).
# TRƯỚC KHI reload: vào trang quản lý tên miền, tạo bản ghi A:
#     admin.studioquocan.vn  ->  IP-VPS
# rồi đợi DNS phân giải đúng (kiểm tra: ping admin.studioquocan.vn ra IP VPS).
# Caddy cần domain trỏ đúng IP để tự xin chứng chỉ HTTPS.

admin.studioquocan.vn {
    encode zstd gzip
    # Backend chạy ở cổng 4100 (đã serve luôn giao diện + API).
    reverse_proxy 127.0.0.1:4100
}

# ------------------------------------------------------------------
# CHƯA có tên miền / DNS chưa trỏ xong? Dùng tạm bằng IP: bỏ comment khối dưới,
# comment khối trên lại, rồi truy cập  http://IP-VPS
# (Chạy IP thì KHÔNG có HTTPS — dùng tạm, mua/trỏ tên miền xong thì đổi lại khối trên.)
# :80 {
#     reverse_proxy 127.0.0.1:4100
# }
