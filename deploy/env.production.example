# ===== .env cho production — chép thành /opt/wedding-admin/app/backend/.env =====
# KHÔNG commit file .env thật. Đây chỉ là mẫu.

PORT=4100
# Đổi thành chuỗi ngẫu nhiên dài (vd: openssl rand -hex 32)
JWT_SECRET=DOI-THANH-CHUOI-NGAU-NHIEN-DAI
JWT_EXPIRES_IN=7d

# ===== Cách B: VPS tự host website khách xem =====
# Bật để mỗi lần Công bố, VPS build lại website tĩnh (tools/build_site.py) và phục vụ cho khách.
BUILD_SITE_LOCAL=true
# Cổng phục vụ website khách xem (tách khỏi app quản trị ở cổng PORT).
SITE_PORT=8080

# Đặt DB và bản clone website vào thư mục data cố định (Litestream sao lưu file DB này).
DB_PATH=/opt/wedding-admin/data/wedding-admin.db
WEBSITE_REPO_DIR=/opt/wedding-admin/data/website-repo
UPLOADS_DIR=/opt/wedding-admin/data/uploads

# Chạy sau Caddy (cùng domain) nên để * là an toàn và gọn.
# Nếu muốn siết chặt: CORS_ORIGIN=https://admin.studioquocan.vn
CORS_ORIGIN=*

# Khóa mã hóa mật khẩu SMTP lưu trong DB. ĐẶT chuỗi ngẫu nhiên riêng (openssl rand -hex 32).
# Không để trùng JWT_SECRET trên production, và KHÔNG đổi sau khi đã lưu SMTP (đổi sẽ phải nhập lại mật khẩu SMTP).
APP_ENCRYPTION_KEY=DOI-THANH-CHUOI-NGAU-NHIEN-RIENG
# Tên hiển thị trong email + tiêu đề
APP_NAME=Quốc An Studio

# ===== Kết nối repo website để "Công bố" =====
WEBSITE_REPO_URL=https://github.com/qt16tc32nghoainam-a11y/website-Wedding.git
WEBSITE_REPO_BRANCH=main
# GitHub Personal Access Token (scope repo / Contents: read-write cho website-Wedding)
GITHUB_TOKEN=
GIT_AUTHOR_NAME=Wedding Admin
GIT_AUTHOR_EMAIL=admin@quocanstudio.vn
